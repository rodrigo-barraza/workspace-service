{
  "name": "workspace-service",
  "version": "0.1.0",
  "description": "Remote development sidecar — connects local workspace to a remote tools-service backend via WebSocket",
  "type": "module",
  "bin": {
    "workspace-service": "./dist/bin/workspace-service.js"
  },
  "main": "dist/AgentClient.js",
  "scripts": {
    "start": "node dist/boot.js",
    "dev": "tsx watch src/boot.ts",
    "dev:local": "set -a && . ./.env && set +a && tsx watch src/bin/workspace-service.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build:standalone": "node standalone/esbuild-standalone.mjs",
    "build:binaries": "npm run build:standalone && node standalone/build-binaries.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@rodrigo-barraza/utilities-library": "^0.2.0",
    "commander": "^14.0.3",
    "diff": "^8.0.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "next",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.8.0"
}
