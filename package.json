{
  "name": "workspace-service",
  "version": "0.1.0",
  "description": "Remote development sidecar — connects local workspace to a remote tools-service backend via WebSocket",
  "type": "module",
  "bin": {
    "workspace-service": "./bin/workspace-service.js"
  },
  "main": "src/AgentClient.js",
  "scripts": {
    "start": "node boot.js",
    "dev": "node --watch boot.js",
    "dev:local": "set -a && . ./.env && set +a && node --watch bin/workspace-service.js",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "commander": "^14.0.3",
    "diff": "^8.0.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6"
  }
}
