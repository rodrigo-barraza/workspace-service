# ════════════════════════════════════════════════════════════════
#  Workspace Service — Local Environment Overrides
# ════════════════════════════════════════════════════════════════
#  These values override secrets from Vault and vault/.env.
#  Only add variables you want to change for local development.
#
#  To use:  cp .env.example .env
#
#  Resolution order (first wins):
#    1. process.env (manual env vars)
#    2. This file (.env)
#    3. Vault service
#    4. Shared vault/.env fallback
# ════════════════════════════════════════════════════════════════

# ── Vault Connection ──────────────────────────────────────────
# Required for Docker/production — connects to vault-service
# to pull WORKSPACE_BACKEND, WORKSPACE_ROOTS, etc.
# VAULT_SERVICE_URL="http://<host>:5599"
# VAULT_SERVICE_TOKEN="<your-vault-token>"

# ── Workspace Config ─────────────────────────────────────────
# WebSocket URL of the tools-service backend
# Accepts ws:// or http:// (auto-converts to ws://)
WORKSPACE_BACKEND=ws://192.168.86.2:5590

# Comma-separated list of workspace root directories to expose
WORKSPACE_ROOTS=/workspace

# API secret for authenticating with tools-service
# Must match your tools-service's AGENT_SECRET
WORKSPACE_SERVICE_SECRET=
