# Workspace Service — Environment Variables
# Copy this file to .env and fill in your values.

# WebSocket URL of the tools-service backend
# Accepts ws:// or http:// (auto-converts to ws://)
WORKSPACE_BACKEND=ws://192.168.86.2:5590

# Comma-separated list of workspace root directories to expose
WORKSPACE_ROOTS=/workspace

# API secret for authenticating with tools-service
# Must match your tools-service's AGENT_SECRET
WORKSPACE_SERVICE_SECRET=
