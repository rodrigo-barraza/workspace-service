# ════════════════════════════════════════════════════════════════
#  Workspace Service — Environment Variables
# ════════════════════════════════════════════════════════════════
#  To use:  cp .env.example .env   (then fill in your values)
#
#  If you have vault-service access, only VAULT_SERVICE_URL and
#  VAULT_SERVICE_TOKEN are needed — the rest will be pulled from
#  the project registry automatically.
#
#  If you do NOT have vault access, you MUST set the workspace
#  config values below directly.
# ════════════════════════════════════════════════════════════════

# ── Vault Connection (optional) ──────────────────────────────
# VAULT_SERVICE_URL="http://<host>:5599"
# VAULT_SERVICE_TOKEN=""

# ── Workspace Config (required without vault) ────────────────
# WebSocket URL of the tools-service backend
# Accepts ws:// or http:// (auto-converts to ws://)
WORKSPACE_BACKEND=ws://<tools-service-host>:5590

# Comma-separated list of workspace root directories to expose
WORKSPACE_ROOTS=/workspace

# API secret for authenticating with tools-service
# Must match your tools-service's AGENT_SECRET
WORKSPACE_SERVICE_SECRET=
