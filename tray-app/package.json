{
  "name": "prism-workspace-agent",
  "version": "1.0.0",
  "description": "Prism Workspace Agent — system tray application for connecting local workspaces to Prism",
  "main": "out/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron out/main.js",
    "dev": "tsc && electron out/main.js",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "author": "Rodrigo Barraza",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0"
  }
}
